bool   i_showFVG         = input.bool(true, "Mostrar Fair Value Gaps (FVG)", group = GRP_POI)
int    i_maxFVG          = input.int(8, "Máx. FVGs Activos", minval = 1, maxval = 50, group = GRP_POI)
float  i_fvgAtrMult      = input.float(0.25, "Filtro Ruido FVG (ATR *)", minval = 0.05, maxval = 2.0, step = 0.05, group = GRP_POI)
string i_fvgMitMode      = input.string("100% Fill", "Modo Mitigación FVG", options = ["100% Fill", "50% Fill"], group = GRP_POI)

// --- Grupo 3: Motor Wyckoff & VSA ---
bool   i_showWyckoff     = input.bool(true, "Mostrar Eventos Wyckoff (SC/AR/ST/Spring/SOS)", group = GRP_WYCK)
bool   i_showTRBox       = input.bool(true, "Mostrar Cajas de Trading Range (TR)", group = GRP_WYCK)
bool   i_showWyckPhases  = input.bool(true, "Mostrar Título Acum./Dist. y Fases (A–E)", group = GRP_WYCK)
