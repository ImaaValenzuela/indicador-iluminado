//@version=6
indicator(
     title           = "SMC + Wyckoff Institutional Engine",
     shorttitle      = "SMC+Wyckoff IE",
     overlay         = true,
     max_boxes_count = 500,
     max_lines_count = 500,
     max_labels_count = 500
 )

// =============================================================================
// 1. INPUTS (AGRUPADOS POR MÓDULO)
// =============================================================================

const string GRP_UI    = "0. Estética y Tema Visual"
const string GRP_SMC   = "1. Estructura SMC"
const string GRP_POI   = "2. Liquidez y POIs"
const string GRP_WYCK  = "3. Motor Wyckoff & VSA"
const string GRP_CONF  = "4. Confluencia, Dashboard y Alertas"
const string GRP_GHOST = "5. Modo Sombra (Proyección Futura)"

// --- Grupo 0: Estética y Tema Visual (Minimalista) ---
string i_uiTheme         = input.string("Minimal Light (Monocromo)", "Tema Visual", options = ["Minimal Light (Monocromo)", "Minimal Light (Acento Sutil)", "Dark Institutional"], group = GRP_UI)
bool   i_showBoxText     = input.bool(false, "Mostrar Etiquetas dentro de Cajas (OB/FVG/TR)", group = GRP_UI)
string i_dashTextSize    = input.string("Pequeño", "Tamaño Texto Dashboard", options = ["Pequeño", "Normal"], group = GRP_UI)
