color  i_colInkCustom    = input.color(#111318, "Color Tinta Principal (Light)", group = GRP_UI)
color  i_colMutedCustom  = input.color(#6B7280, "Color Gris Secundario", group = GRP_UI)

// --- Grupo 1: Estructura SMC ---
bool   i_showSwingStruct = input.bool(true, "Mostrar Estructura Swing", group = GRP_SMC)
int    i_swingLen        = input.int(25, "Lookback Estructura Swing", minval = 5, maxval = 100, group = GRP_SMC)
bool   i_showIntStruct   = input.bool(false, "Mostrar Estructura Interna", group = GRP_SMC)
int    i_intLen          = input.int(5, "Lookback Estructura Interna", minval = 2, maxval = 30, group = GRP_SMC)
string i_breakMode       = input.string("Close", "Confirmación de Ruptura", options = ["Close", "Wick"], group = GRP_SMC)
float  i_dispBodyMult    = input.float(1.5, "Desplazamiento: Cuerpo > ATR *", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_SMC)
float  i_dispVolMult     = input.float(1.2, "Desplazamiento: Volumen > SMA20 *", minval = 0.5, maxval = 5.0, step = 0.1, group = GRP_SMC)
bool   i_showPD          = input.bool(true, "Mostrar Zonas Premium / Discount / EQ", group = GRP_SMC)
int    i_maxStructLines  = input.int(20, "Máx. Líneas de Estructura", minval = 5, maxval = 120, group = GRP_SMC)

// --- Grupo 2: Liquidez y POIs ---
bool   i_showEQ          = input.bool(true, "Mostrar Equal Highs / Lows (EQH/EQL)", group = GRP_POI)
float  i_eqAtrMult       = input.float(0.15, "Tolerancia EQH/EQL (ATR *)", minval = 0.05, maxval = 1.0, step = 0.05, group = GRP_POI)
int    i_maxEQ           = input.int(8, "Máx. Niveles EQH/EQL", minval = 2, maxval = 50, group = GRP_POI)
bool   i_showSweeps      = input.bool(true, "Mostrar Liquidity Sweeps", group = GRP_POI)
int    i_maxSweeps       = input.int(12, "Máx. Etiquetas de Sweep", minval = 5, maxval = 80, group = GRP_POI)
bool   i_showOB          = input.bool(true, "Mostrar Order Blocks (OB)", group = GRP_POI)
int    i_maxOB           = input.int(6, "Máx. Order Blocks Activos", minval = 1, maxval = 40, group = GRP_POI)
int    i_obLookback      = input.int(15, "Búsqueda Vela OB (Velas)", minval = 3, maxval = 50, group = GRP_POI)
string i_obMitMode       = input.string("50% Mean Threshold", "Modo Mitigación OB", options = ["Proximal", "50% Mean Threshold", "Distal Invalidation"], group = GRP_POI)
