int    i_maxTRHistory    = input.int(2, "Máx. Cajas TR en Historial", minval = 1, maxval = 15, group = GRP_WYCK)
int    i_maxWyckLabels   = input.int(20, "Máx. Etiquetas Wyckoff", minval = 10, maxval = 120, group = GRP_WYCK)
float  i_vsaAbsRvol      = input.float(1.8, "VSA Absorción: RVOL >", minval = 1.0, maxval = 5.0, step = 0.1, group = GRP_WYCK)
float  i_climaxRvol      = input.float(2.2, "SC/BC Clímax: RVOL >", minval = 1.2, maxval = 6.0, step = 0.1, group = GRP_WYCK)
float  i_climaxSpread    = input.float(1.8, "SC/BC Clímax: Spread > ATR *", minval = 1.0, maxval = 5.0, step = 0.1, group = GRP_WYCK)
float  i_stMaxRvol       = input.float(0.9, "ST Secondary Test: RVOL <", minval = 0.2, maxval = 1.5, step = 0.05, group = GRP_WYCK)
float  i_sosRvol         = input.float(1.5, "SOS/SOW Ruptura: RVOL >", minval = 1.0, maxval = 5.0, step = 0.1, group = GRP_WYCK)
float  i_sosSpread       = input.float(1.3, "SOS/SOW Ruptura: Spread > ATR *", minval = 0.8, maxval = 4.0, step = 0.1, group = GRP_WYCK)
float  i_lpsMaxRvol      = input.float(0.8, "LPS/LPSY Retroceso: RVOL <", minval = 0.2, maxval = 1.5, step = 0.05, group = GRP_WYCK)
int    i_trMaxBars       = input.int(150, "Duración Máx. Trading Range (Velas)", minval = 30, maxval = 500, group = GRP_WYCK)

// --- Grupo 4: Confluencia, Dashboard y Alertas ---
int    i_minScore        = input.int(75, "Puntaje Mínimo Señal A+ (0-100)", minval = 40, maxval = 100, step = 5, group = GRP_CONF)
int    i_confWindow      = input.int(25, "Ventana de Confluencia (Velas)", minval = 5, maxval = 100, group = GRP_CONF)
int    i_signalCooldown  = input.int(5, "Cooldown entre Señales (Velas)", minval = 1, maxval = 50, group = GRP_CONF)
bool   i_showSignals     = input.bool(true, "Mostrar Etiquetas A+ LONG / A+ SHORT", group = GRP_CONF)
bool   i_showStdSignals  = input.bool(true, "Mostrar Marcas Direccionales ▲ LONG / ▼ SHORT", group = GRP_CONF)
int    i_stdMinScore     = input.int(50, "Puntaje Mínimo ▲ LONG / ▼ SHORT", minval = 25, maxval = 80, step = 5, group = GRP_CONF)
int    i_maxSigLabels    = input.int(25, "Máx. Etiquetas de Señal", minval = 5, maxval = 100, group = GRP_CONF)
bool   i_showDash        = input.bool(true, "Mostrar Dashboard Institucional", group = GRP_CONF)
bool   i_enableDynAlerts = input.bool(false, "Activar alert() Dinámicas con Puntaje", group = GRP_CONF)

// --- Grupo 5: Modo Sombra (Proyección Futura Estimada) ---
bool   i_showGhost       = input.bool(true, "Activar Modo Sombra (Proyección Futura)", group = GRP_GHOST)
int    i_ghostLookback   = input.int(10, "Velas Recientes Analizadas (Momentum/VSA)", minval = 3, maxval = 30, group = GRP_GHOST)
int    i_ghostHorizon    = input.int(15, "Horizonte de Proyección (Velas Futuras)", minval = 6, maxval = 45, group = GRP_GHOST)
bool   i_showGhostCone   = input.bool(true, "Mostrar Cono de Sombra (Volatilidad ATR)", group = GRP_GHOST)

// =============================================================================
// 1B. PALETA SEMÁNTICA MINIMALISTA (LIGHT MONOCROMO / ACENTO SUTIL / DARK)
// =============================================================================

bool  isLightMono   = i_uiTheme == "Minimal Light (Monocromo)"
bool  isLightAccent = i_uiTheme == "Minimal Light (Acento Sutil)"
bool  isDarkTheme   = i_uiTheme == "Dark Institutional"

color colInk        = isDarkTheme ? #E5E7EB : i_colInkCustom
color colMuted      = isDarkTheme ? #8B949E : i_colMutedCustom
color colSubtle     = isDarkTheme ? #4B5563 : #9CA3AF

color i_colBull     = isLightMono ? colInk : isLightAccent ? #166534 : #089981
color i_colBear     = isLightMono ? #52525B : isLightAccent ? #9F1239 : #F23645
color i_colEq       = colMuted

color colFvgBg      = color.new(i_colImbalance, isDarkTheme ? 84 : 82)
color colFvgBorder  = color.new(i_colImbalance, isDarkTheme ? 65 : 68)
color colFvgText    = color.new(colMuted, 25)

color colObBullBg   = isLightMono ? color.new(colInk, 93) : isLightAccent ? color.new(#166534, 93) : color.new(#089981, 87)
color colObBullBrd  = isLightMono ? color.new(colInk, 62) : isLightAccent ? color.new(#166534, 58) : color.new(#089981, 40)
color colObBearBg   = isLightMono ? color.new(#71717A, 91) : isLightAccent ? color.new(#9F1239, 93) : color.new(#F23645, 87)
color colObBearBrd  = isLightMono ? color.new(#52525B, 58) : isLightAccent ? color.new(#9F1239, 58) : color.new(#F23645, 40)

color colBbBullBrd  = isLightMono ? color.new(colInk, 55) : isLightAccent ? color.new(#166534, 50) : color.new(#2962FF, 35)
color colBbBearBrd  = isLightMono ? color.new(#52525B, 55) : isLightAccent ? color.new(#9F1239, 50) : color.new(#FF9800, 35)

color colTrBg       = color.new(colSubtle, isDarkTheme ? 95 : 96)
color colTrBrd      = color.new(colMuted, isDarkTheme ? 58 : 65)
color colTrLine     = color.new(colMuted, isDarkTheme ? 50 : 58)

color colPdPremBg   = isLightMono ? color.new(colSubtle, 96) : isLightAccent ? color.new(#9F1239, 97) : color.new(#F23645, 95)
color colPdDiscBg   = isLightMono ? color.new(colInk, 97) : isLightAccent ? color.new(#166534, 97) : color.new(#089981, 95)
color colPdNoneBrd  = color.new(colSubtle, 100)

color colSigLongBg  = isLightMono ? #111318 : isLightAccent ? #14532D : #089981
color colSigShortBg = isLightMono ? #3F3F46 : isLightAccent ? #881337 : #F23645
color colVsaDot     = isDarkTheme ? color.new(#9CA3AF, 35) : color.new(colInk, 45)

color colDashBg     = isDarkTheme ? color.new(#131722, 10) : color.new(#FFFFFF, 4)
color colDashHead   = isDarkTheme ? color.new(#1E222D, 0) : color.new(#F4F4F5, 0)
color colDashBrd    = isDarkTheme ? color.new(#2A2E39, 0) : color.new(#E4E4E7, 0)
color colDashTitle  = isDarkTheme ? color.white : #111318
color colDashMuted  = isDarkTheme ? #9CA3AF : #71717A
color colDashVal    = isDarkTheme ? #F3F4F6 : #18181B
color colGhostLine  = isDarkTheme ? color.new(#D1D5DB, 40) : color.new(colInk, 45)
color colGhostEdge  = color.new(colSubtle, isDarkTheme ? 82 : 84)
color colGhostCone  = color.new(i_colImbalance, isDarkTheme ? 90 : 88)
string dashSz       = i_dashTextSize == "Pequeño" ? size.tiny : size.small

// =============================================================================
// 2. USER DEFINED TYPES (UDTs)
// =============================================================================

type SwingPoint
    float price
    int   barIdx
    bool  isHigh
    bool  broken
    bool  swept

type EqualLevel
    float price
    int   firstBar
    int   lastBar
    bool  isHigh
    bool  swept
    line  lineId
    label lblId

type OrderBlock
    float top
    float bottom
    float mid
    int   originBar
    bool  isBull
    bool  isBreaker
    bool  mitigated
    bool  fromSOS
    box   boxId

type FVG
    float top
    float bottom
    float mid
    int   originBar
    bool  isBull
    bool  mitigated
    bool  fromSOS
    box   boxId

type TradingRange
    bool  active          = false
    int   bias            = 0               // 1 = Acumulación, -1 = Distribución, 0 = Ninguno
    int   phase           = 0               // 0 = Tendencia, 1 = SC/BC, 2 = AR (TR), 3 = ST, 4 = Spring/UTAD, 5 = SOS/SOW, 6 = LPS/LPSY
    int   lastPhaseMark   = 0               // Última fase Wyckoff (1..5 -> A..E) ya dibujada
    float top             = na
    float bottom          = na
    int   startBar        = na
    int   climaxBar       = na
    int   arBar           = na
    int   lastSTBar       = na
    bool  hasST           = false
    bool  hasManip        = false
    int   manipBar        = na
    bool  hasBreakout     = false
    int   breakoutBar     = na
    int   lpsBar          = na
    bool  pendingManip    = false
    int   pendingManipBar = na
    float pendingExtreme  = na
    box   trBox           = na
    line  topLine         = na
    line  botLine         = na

type StructDrawing
    line  lineId
    label lblId

// =============================================================================
// 3. FUNCIONES AUXILIARES Y GESTIÓN DE MEMORIA (ARRAYS CON LÍMITE DINÁMICO)
// =============================================================================

f_pushStructDrawing(array<StructDrawing> arr, StructDrawing item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        StructDrawing old = array.shift(arr)
        if not na(old.lineId)
            line.delete(old.lineId)
        if not na(old.lblId)
            label.delete(old.lblId)

f_pushLabel(array<label> arr, label item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        label old = array.shift(arr)
        if not na(old)
            label.delete(old)

f_pushSwing(array<SwingPoint> arr, SwingPoint item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        array.shift(arr)

f_pushEQ(array<EqualLevel> arr, EqualLevel item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        EqualLevel old = array.shift(arr)
        if not na(old.lineId)
            line.delete(old.lineId)
        if not na(old.lblId)
            label.delete(old.lblId)

f_pushOB(array<OrderBlock> arr, OrderBlock item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        OrderBlock old = array.shift(arr)
        if not na(old.boxId)
            box.delete(old.boxId)

f_pushFVG(array<FVG> arr, FVG item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        FVG old = array.shift(arr)
        if not na(old.boxId)
            box.delete(old.boxId)

f_pushBox(array<box> arr, box item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        box old = array.shift(arr)
        if not na(old)
            box.delete(old)

f_pushLine(array<line> arr, line item, int maxLen) =>
    array.push(arr, item)
    while array.size(arr) > maxLen
        line old = array.shift(arr)
        if not na(old)
            line.delete(old)

f_obExistsAtBar(array<OrderBlock> arr, int targetBar, bool wantBull) =>
    bool found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            OrderBlock ob = array.get(arr, i)
            if ob.originBar == targetBar and ob.isBull == wantBull
                found := true
                break
    found

f_eqExistsNear(array<EqualLevel> arr, float lvlPrice, bool isHigh, float tol) =>
    bool found = false
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            EqualLevel eq = array.get(arr, i)
            if not eq.swept and eq.isHigh == isHigh and math.abs(eq.price - lvlPrice) <= tol
                found := true
                break
    found

f_hasActivePOI(array<OrderBlock> obs, array<FVG> fvgs, bool wantBull, float refLow, float refHigh, float atr, int curBar, int window) =>
    bool ok = false
    float proxDist = not na(atr) ? atr * 3.0 : 0.0
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            OrderBlock ob = array.get(obs, i)
            if not ob.mitigated and ob.isBull == wantBull
                bool nearPrice = refLow <= ob.top + proxDist and refHigh >= ob.bottom - proxDist
                bool recentOrigin = (curBar - ob.originBar) <= window
                if nearPrice or recentOrigin
                    ok := true
                    break
    if not ok and array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            FVG f = array.get(fvgs, i)
            if not f.mitigated and f.isBull == wantBull
                bool nearPrice = refLow <= f.top + proxDist and refHigh >= f.bottom - proxDist
                bool recentOrigin = (curBar - f.originBar) <= window
                if nearPrice or recentOrigin
                    ok := true
                    break
    ok

f_findNearestPOI(array<OrderBlock> obs, array<FVG> fvgs, bool wantBull, float curClose, float maxDist) =>
    float bestMid  = na
    float bestDist = maxDist
    if array.size(obs) > 0
        for i = 0 to array.size(obs) - 1
            OrderBlock ob = array.get(obs, i)
            if not ob.mitigated and ob.isBull == wantBull
                float d = wantBull ? (curClose - ob.mid) : (ob.mid - curClose)
                if d > 0.0 and d < bestDist
                    bestDist := d
                    bestMid  := ob.mid
    if array.size(fvgs) > 0
        for i = 0 to array.size(fvgs) - 1
            FVG f = array.get(fvgs, i)
            if not f.mitigated and f.isBull == wantBull
                float d = wantBull ? (curClose - f.mid) : (f.mid - curClose)
                if d > 0.0 and d < bestDist
                    bestDist := d
                    bestMid  := f.mid
    bestMid

f_trendLabel(int trendVal) =>
    trendVal == 1 ? "Alcista" : trendVal == -1 ? "Bajista" : "Neutral"

f_wyckoffPhaseLetter(int phase) =>
    switch phase
        1 => "Fase A"
        2 => "Fase A"
        3 => "Fase B"
        4 => "Fase C"
        5 => "Fase D"
        6 => "Fase E"
        => "—"

f_wyckoffBoxTitle(int bias, int phase) =>
    string prefix = bias == 1 ? "ACUMULACIÓN" : "DISTRIBUCIÓN"
    prefix + " · " + f_wyckoffPhaseLetter(phase)

f_wyckoffStateLabel(int phase, int bias) =>
    switch phase
        1 => bias == 1 ? "Acum. · Fase A (SC)" : "Dist. · Fase A (BC)"
        2 => bias == 1 ? "Acum. · Fase A (AR)" : "Dist. · Fase A (AR)"
        3 => bias == 1 ? "Acum. · Fase B (ST)" : "Dist. · Fase B (ST)"
        4 => bias == 1 ? "Acum. · Fase C (Spring)" : "Dist. · Fase C (UTAD)"
        5 => bias == 1 ? "Acum. · Fase D (SOS)" : "Dist. · Fase D (SOW)"
        6 => bias == 1 ? "Acum. · Fase E (LPS)" : "Dist. · Fase E (LPSY)"
        => "Tendencia"

// =============================================================================
// 4. SERIES GLOBALES INCONDICIONALES (EVITA ADVERTENCIAS Y REPINTADO EN v6)
// =============================================================================

float atr14      = ta.atr(14)
float volSma20   = ta.sma(volume, 20)
float ema50      = ta.ema(close, 50)
float bodySize   = math.abs(close - open)
float barRange   = high - low
float upperWick  = high - math.max(open, close)
float lowerWick  = math.min(open, close) - low

bool  hasVolData = not na(volSma20) and volSma20 > 0.0
float rvol       = hasVolData ? (volume / volSma20) : 0.0
float relSpread  = (not na(atr14) and atr14 > 0.0) ? (barRange / atr14) : 0.0
float closePos   = barRange > 0.0 ? ((close - low) / barRange) : 0.5

// Presión de velas recientes para Modo Sombra (ponderada por cuerpo, rechazo de mechas y RVOL)
float candlePress   = barRange > 0.0 ? ((close - open) / barRange) : 0.0
float wickPress     = barRange > 0.0 ? ((lowerWick - upperWick) / barRange) : 0.0
float barImpulse    = (candlePress * 0.65 + wickPress * 0.35) * (hasVolData ? math.min(rvol, 3.0) : 1.0)
float avgCandleBias = ta.sma(barImpulse, i_ghostLookback)
float prevGhostPx   = bar_index >= i_ghostLookback ? close[i_ghostLookback] : open
float avgPriceSlope = (close - prevGhostPx) / float(i_ghostLookback)

// Desplazamiento (Spec: cuerpo > 1.5 * ATR(14) y volumen > 1.2 * SMA(vol, 20))
bool dispBodyOk  = not na(atr14) and atr14 > 0.0 and bodySize > (i_dispBodyMult * atr14)
bool dispVolOk   = hasVolData and (volume > (i_dispVolMult * volSma20))
bool isDispBull  = dispBodyOk and dispVolOk and close > open
bool isDispBear  = dispBodyOk and dispVolOk and close < open

// Pivotes incondicionales (confirmados N velas después — 0 lookahead)
float swingPH = ta.pivothigh(high, i_swingLen, i_swingLen)
float swingPL = ta.pivotlow(low, i_swingLen, i_swingLen)
float intPH   = ta.pivothigh(high, i_intLen, i_intLen)
float intPL   = ta.pivotlow(low, i_intLen, i_intLen)

// VSA Anomalía de Absorción (Spec: RVOL > 1.8 y cuerpo < 35% rango ó mecha rechazo > 50%)
bool smallBody      = barRange > 0.0 and bodySize < (0.35 * barRange)
bool bullRejectWick = barRange > 0.0 and lowerWick > (0.50 * barRange)
bool bearRejectWick = barRange > 0.0 and upperWick > (0.50 * barRange)
bool vsaAbsRaw      = barstate.isconfirmed and hasVolData and rvol > i_vsaAbsRvol and (smallBody or bullRejectWick or bearRejectWick)
bool vsaBullAbs     = vsaAbsRaw and (bullRejectWick or (not bearRejectWick and closePos >= 0.5))
bool vsaBearAbs     = vsaAbsRaw and not vsaBullAbs

// =============================================================================
// 5. ESTADO PERSISTENTE (ARRAYS, UDTs Y VARIABLES DE SEGUIMIENTO)
// =============================================================================

// --- Módulo 1: Estructura SMC ---
var int        swingTrend     = 0
var int        intTrend       = 0
var SwingPoint lastSwingHigh  = na
var SwingPoint lastSwingLow   = na
var SwingPoint lastIntHigh    = na
var SwingPoint lastIntLow     = na

var array<SwingPoint>    swingHighs    = array.new<SwingPoint>()
var array<SwingPoint>    swingLows     = array.new<SwingPoint>()
var array<SwingPoint>    intHighs      = array.new<SwingPoint>()
var array<SwingPoint>    intLows       = array.new<SwingPoint>()
var array<StructDrawing> structDraws   = array.new<StructDrawing>()

// Premium / Discount / Equilibrium drawings
var box   pdPremBox = na
var box   pdDiscBox = na
var line  pdEqLine  = na
var label pdPremLbl = na
var label pdEqLbl   = na
var label pdDiscLbl = na
var float pdHigh    = na
var float pdLow     = na
var float pdEq      = na

// --- Módulo 2: Liquidez y POIs ---
var array<EqualLevel> eqLevels    = array.new<EqualLevel>()
var array<label>      sweepLabels = array.new<label>()
var array<OrderBlock> obList      = array.new<OrderBlock>()
var array<FVG>        fvgList     = array.new<FVG>()
var int               lastDispBullBar = na
var int               lastDispBearBar = na

// --- Módulo 3: Motor Wyckoff ---
var TradingRange tr = TradingRange.new()
var array<box>   trHistBoxes   = array.new<box>()
var array<line>  trHistLines   = array.new<line>()
var array<label> wyckLabels    = array.new<label>()
var bool         prevClimaxDn  = false
var float        prevClimaxLow = na
var int          prevClimaxBarDn = na
var bool         prevClimaxUp  = false
var float        prevClimaxHi  = na
var int          prevClimaxBarUp = na

// --- Módulo 4: Confluencia y Señales ---
var int          lastBullManipBar   = na
var int          lastBearManipBar   = na
var int          lastBullStructBar  = na
var int          lastBearStructBar  = na
var int          lastBullVolConfBar = na
var int          lastBearVolConfBar = na
var int          lastLongSigBar     = na
var int          lastShortSigBar    = na
var int          lastConfluenceScore = 0
var string       lastConfluenceDir   = "—"
var int          liveScoreLong       = 0
var int          liveScoreShort      = 0
var array<label> sigLabels           = array.new<label>()

// --- Banderas de eventos de la vela actual (evaluadas solo en barstate.isconfirmed) ---
bool bullBOSNow        = false
bool bearBOSNow        = false
bool bullCHoCHNow      = false
bool bearCHoCHNow      = false
bool bullMSSNow        = false
bool bearMSSNow        = false
bool bullSweepNow      = false
bool bearSweepNow      = false
bool inBullOBNow       = false
bool inBearOBNow       = false
bool enteredActiveOB   = false
bool inBullFVGNow      = false
bool inBearFVGNow      = false
bool wyckoffSpringNow  = false
bool wyckoffUtadNow    = false
bool wyckoffSosNow     = false
bool wyckoffSowNow     = false
bool wyckoffLpsNow     = false
bool wyckoffLpsyNow    = false
bool wyckoffBullSTNow  = false
bool wyckoffBearSTNow  = false
bool sigAPlusLong      = false
bool sigAPlusShort     = false

// =============================================================================
// 6. EVALUACIÓN PRINCIPAL (ESTRICTAMENTE EN CIERRE DE VELA: barstate.isconfirmed)
// =============================================================================

if barstate.isconfirmed
    if isDispBull
        lastDispBullBar := bar_index
    if isDispBear
        lastDispBearBar := bar_index

    if vsaBullAbs
        lastBullVolConfBar := bar_index
    if vsaBearAbs
        lastBearVolConfBar := bar_index

    float eqTol = not na(atr14) ? (i_eqAtrMult * atr14) : 0.0

    // -------------------------------------------------------------------------
    // MÓDULO 1A: REGISTRO DE PIVOTES CONFIRMADOS + DETECCIÓN DE EQH / EQL
    // -------------------------------------------------------------------------

    // --- Swing High confirmado ---
    if not na(swingPH)
        int pivBar = bar_index - i_swingLen
        if i_showEQ and eqTol > 0.0 and array.size(swingHighs) > 0
            for i = array.size(swingHighs) - 1 to 0
                SwingPoint prev = array.get(swingHighs, i)
                if not prev.broken and not prev.swept and math.abs(swingPH - prev.price) <= eqTol
                    if not f_eqExistsNear(eqLevels, swingPH, true, eqTol)
                        float eqPrice = (swingPH + prev.price) * 0.5
                        line lEq = line.new(
                             x1 = prev.barIdx, y1 = eqPrice, x2 = pivBar, y2 = eqPrice,
                             color = color.new(colMuted, 40), style = line.style_dotted, width = 1
                         )
                        int midX = int(math.floor((prev.barIdx + pivBar) / 2))
                        label lbEq = label.new(
                             x = midX, y = eqPrice, text = "$$$ EQH",
                             style = label.style_none, textcolor = colMuted, size = size.tiny
                         )
                        f_pushEQ(eqLevels, EqualLevel.new(eqPrice, prev.barIdx, pivBar, true, false, lEq, lbEq), i_maxEQ)
                    break
        SwingPoint newSH = SwingPoint.new(swingPH, pivBar, true, false, false)
        f_pushSwing(swingHighs, newSH, 15)
        lastSwingHigh := newSH

    // --- Swing Low confirmado ---
    if not na(swingPL)
        int pivBar = bar_index - i_swingLen
        if i_showEQ and eqTol > 0.0 and array.size(swingLows) > 0
            for i = array.size(swingLows) - 1 to 0
                SwingPoint prev = array.get(swingLows, i)
                if not prev.broken and not prev.swept and math.abs(swingPL - prev.price) <= eqTol
                    if not f_eqExistsNear(eqLevels, swingPL, false, eqTol)
                        float eqPrice = (swingPL + prev.price) * 0.5
                        line lEq = line.new(
                             x1 = prev.barIdx, y1 = eqPrice, x2 = pivBar, y2 = eqPrice,
                             color = color.new(colMuted, 40), style = line.style_dotted, width = 1
                         )
                        int midX = int(math.floor((prev.barIdx + pivBar) / 2))
                        label lbEq = label.new(
                             x = midX, y = eqPrice, text = "$$$ EQL",
                             style = label.style_none, textcolor = colMuted, size = size.tiny
                         )
                        f_pushEQ(eqLevels, EqualLevel.new(eqPrice, prev.barIdx, pivBar, false, false, lEq, lbEq), i_maxEQ)
                    break
        SwingPoint newSL = SwingPoint.new(swingPL, pivBar, false, false, false)
        f_pushSwing(swingLows, newSL, 15)
        lastSwingLow := newSL

    // --- Internal High confirmado ---
    if not na(intPH)
        int pivBar = bar_index - i_intLen
        if i_showEQ and eqTol > 0.0 and array.size(intHighs) > 0
            for i = array.size(intHighs) - 1 to 0
                SwingPoint prev = array.get(intHighs, i)
                if not prev.broken and not prev.swept and (pivBar - prev.barIdx) >= i_intLen and math.abs(intPH - prev.price) <= eqTol
                    if not f_eqExistsNear(eqLevels, intPH, true, eqTol)
                        float eqPrice = (intPH + prev.price) * 0.5
                        line lEq = line.new(
                             x1 = prev.barIdx, y1 = eqPrice, x2 = pivBar, y2 = eqPrice,
                             color = color.new(colSubtle, 35), style = line.style_dotted, width = 1
                         )
                        int midX = int(math.floor((prev.barIdx + pivBar) / 2))
                        label lbEq = label.new(
                             x = midX, y = eqPrice, text = "$$$",
                             style = label.style_none, textcolor = colSubtle, size = size.tiny
                         )
                        f_pushEQ(eqLevels, EqualLevel.new(eqPrice, prev.barIdx, pivBar, true, false, lEq, lbEq), i_maxEQ)
                    break
        SwingPoint newIH = SwingPoint.new(intPH, pivBar, true, false, false)
        f_pushSwing(intHighs, newIH, 15)
        lastIntHigh := newIH

    // --- Internal Low confirmado ---
    if not na(intPL)
        int pivBar = bar_index - i_intLen
        if i_showEQ and eqTol > 0.0 and array.size(intLows) > 0
            for i = array.size(intLows) - 1 to 0
                SwingPoint prev = array.get(intLows, i)
                if not prev.broken and not prev.swept and (pivBar - prev.barIdx) >= i_intLen and math.abs(intPL - prev.price) <= eqTol
                    if not f_eqExistsNear(eqLevels, intPL, false, eqTol)
                        float eqPrice = (intPL + prev.price) * 0.5
                        line lEq = line.new(
                             x1 = prev.barIdx, y1 = eqPrice, x2 = pivBar, y2 = eqPrice,
                             color = color.new(colSubtle, 35), style = line.style_dotted, width = 1
                         )
                        int midX = int(math.floor((prev.barIdx + pivBar) / 2))
                        label lbEq = label.new(
                             x = midX, y = eqPrice, text = "$$$",
                             style = label.style_none, textcolor = colSubtle, size = size.tiny
                         )
                        f_pushEQ(eqLevels, EqualLevel.new(eqPrice, prev.barIdx, pivBar, false, false, lEq, lbEq), i_maxEQ)
                    break
        SwingPoint newIL = SwingPoint.new(intPL, pivBar, false, false, false)
        f_pushSwing(intLows, newIL, 15)
        lastIntLow := newIL

    // -------------------------------------------------------------------------
    // MÓDULO 2A: DETECCIÓN DE LIQUIDITY SWEEPS (SWINGS + EQH/EQL)
    // -------------------------------------------------------------------------

    // Barrido sobre EQH / EQL
    if array.size(eqLevels) > 0
        for i = array.size(eqLevels) - 1 to 0
            EqualLevel eq = array.get(eqLevels, i)
            if not eq.swept
                if eq.isHigh
                    if high > eq.price and close < eq.price
                        eq.swept := true
                        bearSweepNow := true
                        lastBearManipBar := bar_index
                        if not na(eq.lineId)
                            line.set_x2(eq.lineId, bar_index)
                    else if close > eq.price
                        eq.swept := true
                else
                    if low < eq.price and close > eq.price
                        eq.swept := true
                        bullSweepNow := true
                        lastBullManipBar := bar_index
                        if not na(eq.lineId)
                            line.set_x2(eq.lineId, bar_index)
                    else if close < eq.price
                        eq.swept := true

    // Barrido sobre Swing Highs previos
    if array.size(swingHighs) > 0
        for i = array.size(swingHighs) - 1 to 0
            SwingPoint sp = array.get(swingHighs, i)
            if not sp.broken and not sp.swept and bar_index > sp.barIdx
                if high > sp.price and close < sp.price
                    sp.swept := true
                    bearSweepNow := true
                    lastBearManipBar := bar_index

    // Barrido sobre Swing Lows previos
    if array.size(swingLows) > 0
        for i = array.size(swingLows) - 1 to 0
            SwingPoint sp = array.get(swingLows, i)
            if not sp.broken and not sp.swept and bar_index > sp.barIdx
                if low < sp.price and close > sp.price
                    sp.swept := true
                    bullSweepNow := true
                    lastBullManipBar := bar_index

    if i_showSweeps and bullSweepNow
        label lbSw = label.new(
             x = bar_index, y = low - (0.12 * nz(atr14)), text = "×",
             style = label.style_none, textcolor = i_colBull, size = size.tiny,
             tooltip = "Liquidity Sweep Alcista (SSL)"
         )
        f_pushLabel(sweepLabels, lbSw, i_maxSweeps)

    if i_showSweeps and bearSweepNow
        label lbSw = label.new(
             x = bar_index, y = high + (0.12 * nz(atr14)), text = "×",
             style = label.style_none, textcolor = i_colBear, size = size.tiny,
             tooltip = "Liquidity Sweep Bajista (BSL)"
         )
        f_pushLabel(sweepLabels, lbSw, i_maxSweeps)

    // -------------------------------------------------------------------------
    // MÓDULO 1B: RUPTURAS DE ESTRUCTURA (BOS / CHoCH / MSS) + CREACIÓN DE OB
    // -------------------------------------------------------------------------

    float bullBreakPx = i_breakMode == "Close" ? close : high
    float bearBreakPx = i_breakMode == "Close" ? close : low

    bool recentDispBull = isDispBull or (not na(lastDispBullBar) and (bar_index - lastDispBullBar) <= 3)
    bool recentDispBear = isDispBear or (not na(lastDispBearBar) and (bar_index - lastDispBearBar) <= 3)

    bool createBullOB = false
    bool createBearOB = false

    // --- Estructura Swing Alcista ---
    if not na(lastSwingHigh) and not lastSwingHigh.broken and bar_index > lastSwingHigh.barIdx
        if bullBreakPx > lastSwingHigh.price
            lastSwingHigh.broken := true
            bool isReversal = swingTrend == -1
            bool isMSS      = isReversal and isDispBull
            string tag      = isMSS ? "MSS" : (isReversal ? "CHoCH" : "BOS")
            swingTrend := 1
            if isMSS
                bullMSSNow := true
                lastBullStructBar := bar_index
            else if isReversal
                bullCHoCHNow := true
            else
                bullBOSNow := true
            if recentDispBull
                createBullOB := true
            if i_showSwingStruct
                line lS = line.new(
                     x1 = lastSwingHigh.barIdx, y1 = lastSwingHigh.price,
                     x2 = bar_index, y2 = lastSwingHigh.price,
                     color = color.new(i_colBull, isMSS ? 15 : 40),
                     style = isMSS ? line.style_solid : line.style_dashed,
                     width = 1
                 )
                int midX = int(math.floor((lastSwingHigh.barIdx + bar_index) / 2))
                label lbS = label.new(
                     x = midX, y = lastSwingHigh.price, text = tag,
                     style = label.style_none, textcolor = color.new(i_colBull, isMSS ? 0 : 20),
                     size = size.tiny
                 )
                f_pushStructDrawing(structDraws, StructDrawing.new(lS, lbS), i_maxStructLines)

    // --- Estructura Swing Bajista ---
    if not na(lastSwingLow) and not lastSwingLow.broken and bar_index > lastSwingLow.barIdx
        if bearBreakPx < lastSwingLow.price
            lastSwingLow.broken := true
            bool isReversal = swingTrend == 1
            bool isMSS      = isReversal and isDispBear
            string tag      = isMSS ? "MSS" : (isReversal ? "CHoCH" : "BOS")
            swingTrend := -1
            if isMSS
                bearMSSNow := true
                lastBearStructBar := bar_index
            else if isReversal
                bearCHoCHNow := true
            else
                bearBOSNow := true
            if recentDispBear
                createBearOB := true
            if i_showSwingStruct
                line lS = line.new(
                     x1 = lastSwingLow.barIdx, y1 = lastSwingLow.price,
                     x2 = bar_index, y2 = lastSwingLow.price,
                     color = color.new(i_colBear, isMSS ? 15 : 40),
                     style = isMSS ? line.style_solid : line.style_dashed,
                     width = 1
                 )
                int midX = int(math.floor((lastSwingLow.barIdx + bar_index) / 2))
                label lbS = label.new(
                     x = midX, y = lastSwingLow.price, text = tag,
                     style = label.style_none, textcolor = color.new(i_colBear, isMSS ? 0 : 20),
                     size = size.tiny
                 )
                f_pushStructDrawing(structDraws, StructDrawing.new(lS, lbS), i_maxStructLines)

    // --- Estructura Interna Alcista ---
    if not na(lastIntHigh) and not lastIntHigh.broken and bar_index > lastIntHigh.barIdx
        if bullBreakPx > lastIntHigh.price
            lastIntHigh.broken := true
            bool isReversal = intTrend == -1
            bool isMSS      = isReversal and isDispBull
            string tag      = isMSS ? "iMSS" : (isReversal ? "iCHoCH" : "iBOS")
            intTrend := 1
            if isMSS
                bullMSSNow := true
                lastBullStructBar := bar_index
            else if isReversal
                bullCHoCHNow := true
            else
                bullBOSNow := true
            if recentDispBull
                createBullOB := true
            if i_showIntStruct
                line lI = line.new(
                     x1 = lastIntHigh.barIdx, y1 = lastIntHigh.price,
                     x2 = bar_index, y2 = lastIntHigh.price,
                     color = color.new(colSubtle, 40), style = line.style_dotted, width = 1
                 )
                int midX = int(math.floor((lastIntHigh.barIdx + bar_index) / 2))
                label lbI = label.new(
                     x = midX, y = lastIntHigh.price, text = tag,
                     style = label.style_none, textcolor = colSubtle, size = size.tiny
                 )
                f_pushStructDrawing(structDraws, StructDrawing.new(lI, lbI), i_maxStructLines)

    // --- Estructura Interna Bajista ---
    if not na(lastIntLow) and not lastIntLow.broken and bar_index > lastIntLow.barIdx
        if bearBreakPx < lastIntLow.price
            lastIntLow.broken := true
            bool isReversal = intTrend == 1
            bool isMSS      = isReversal and isDispBear
            string tag      = isMSS ? "iMSS" : (isReversal ? "iCHoCH" : "iBOS")
            intTrend := -1
            if isMSS
                bearMSSNow := true
                lastBearStructBar := bar_index
            else if isReversal
                bearCHoCHNow := true
            else
                bearBOSNow := true
            if recentDispBear
                createBearOB := true
            if i_showIntStruct
                line lI = line.new(
                     x1 = lastIntLow.barIdx, y1 = lastIntLow.price,
                     x2 = bar_index, y2 = lastIntLow.price,
                     color = color.new(colSubtle, 40), style = line.style_dotted, width = 1
                 )
                int midX = int(math.floor((lastIntLow.barIdx + bar_index) / 2))
                label lbI = label.new(
                     x = midX, y = lastIntLow.price, text = tag,
                     style = label.style_none, textcolor = colSubtle, size = size.tiny
                 )
                f_pushStructDrawing(structDraws, StructDrawing.new(lI, lbI), i_maxStructLines)

    // -------------------------------------------------------------------------
    // MÓDULO 1C: ZONAS PREMIUM / DISCOUNT / EQUILIBRIUM (MINIMALISTA)
    // -------------------------------------------------------------------------

    if not na(lastSwingHigh) and not na(lastSwingLow) and lastSwingHigh.price > lastSwingLow.price
        pdHigh := lastSwingHigh.price
        pdLow  := lastSwingLow.price
        pdEq   := (pdHigh + pdLow) * 0.5
        int pdLeft  = math.min(lastSwingHigh.barIdx, lastSwingLow.barIdx)
        int pdRight = bar_index + 4

        if i_showPD
            if na(pdPremBox)
                pdPremBox := box.new(
                     left = pdLeft, top = pdHigh, right = pdRight, bottom = pdEq,
                     border_color = colPdNoneBrd, border_width = 0,
                     bgcolor = colPdPremBg
                 )
            else
                box.set_lefttop(pdPremBox, pdLeft, pdHigh)
                box.set_rightbottom(pdPremBox, pdRight, pdEq)

            if na(pdDiscBox)
                pdDiscBox := box.new(
                     left = pdLeft, top = pdEq, right = pdRight, bottom = pdLow,
                     border_color = colPdNoneBrd, border_width = 0,
                     bgcolor = colPdDiscBg
                 )
            else
                box.set_lefttop(pdDiscBox, pdLeft, pdEq)
                box.set_rightbottom(pdDiscBox, pdRight, pdLow)

            if na(pdEqLine)
                pdEqLine := line.new(
                     x1 = pdLeft, y1 = pdEq, x2 = pdRight, y2 = pdEq,
                     color = color.new(colSubtle, 35), style = line.style_dotted, width = 1
                 )
            else
                line.set_xy1(pdEqLine, pdLeft, pdEq)
                line.set_xy2(pdEqLine, pdRight, pdEq)

            if na(pdPremLbl)
                pdPremLbl := label.new(
                     x = pdRight, y = pdHigh, text = "Premium",
                     style = label.style_none, textcolor = color.new(colMuted, 25), size = size.tiny
                 )
            else
                label.set_xy(pdPremLbl, pdRight, pdHigh)

            if na(pdEqLbl)
                pdEqLbl := label.new(
                     x = pdRight, y = pdEq, text = "50%",
                     style = label.style_none, textcolor = color.new(colMuted, 20), size = size.tiny
                 )
            else
                label.set_xy(pdEqLbl, pdRight, pdEq)

            if na(pdDiscLbl)
                pdDiscLbl := label.new(
                     x = pdRight, y = pdLow, text = "Discount",
                     style = label.style_none, textcolor = color.new(colMuted, 25), size = size.tiny
                 )
            else
                label.set_xy(pdDiscLbl, pdRight, pdLow)

    // -------------------------------------------------------------------------
    // MÓDULO 2B: ORDER BLOCKS (CREACIÓN, MITIGACIÓN Y BREAKER BLOCKS)
    // -------------------------------------------------------------------------

    int maxObSearch = math.min(i_obLookback, bar_index)

    if createBullOB and maxObSearch >= 1
        int obOffset = -1
        for k = 1 to maxObSearch
            if close[k] < open[k]
                obOffset := k
                break
        if obOffset > 0
            int originBar = bar_index - obOffset
            if not f_obExistsAtBar(obList, originBar, true)
                float obTop = high[obOffset]
                float obBot = low[obOffset]
                float obMid = (obTop + obBot) * 0.5
                box bOb = i_showOB ? box.new(
                     left = originBar, top = obTop, right = bar_index + 2, bottom = obBot,
                     border_color = colObBullBrd, border_width = 1,
                     bgcolor = colObBullBg,
                     text = i_showBoxText ? "OB+" : "", text_size = size.tiny, text_color = color.new(i_colBull, 25),
                     text_halign = text.align_right, text_valign = text.align_center
                 ) : box(na)
                f_pushOB(obList, OrderBlock.new(obTop, obBot, obMid, originBar, true, false, false, false, bOb), i_maxOB)

    if createBearOB and maxObSearch >= 1
        int obOffset = -1
        for k = 1 to maxObSearch
            if close[k] > open[k]
                obOffset := k
                break
        if obOffset > 0
            int originBar = bar_index - obOffset
            if not f_obExistsAtBar(obList, originBar, false)
                float obTop = high[obOffset]
                float obBot = low[obOffset]
                float obMid = (obTop + obBot) * 0.5
                box bOb = i_showOB ? box.new(
                     left = originBar, top = obTop, right = bar_index + 2, bottom = obBot,
                     border_color = colObBearBrd, border_width = 1,
                     bgcolor = colObBearBg,
                     text = i_showBoxText ? "OB-" : "", text_size = size.tiny, text_color = color.new(i_colBear, 25),
                     text_halign = text.align_right, text_valign = text.align_center
                 ) : box(na)
                f_pushOB(obList, OrderBlock.new(obTop, obBot, obMid, originBar, false, false, false, false, bOb), i_maxOB)

    // Actualizar / mitigar / convertir a Breaker los Order Blocks activos
    if array.size(obList) > 0
        for i = array.size(obList) - 1 to 0
            OrderBlock ob = array.get(obList, i)
            if bar_index > ob.originBar
                if not na(ob.boxId)
                    box.set_right(ob.boxId, bar_index + 2)

                // Detectar si el precio entra en el OB activo (para alerta y confluencia)
                bool touchingOB = low <= ob.top and high >= ob.bottom
                if touchingOB
                    enteredActiveOB := true
                    if ob.isBull
                        inBullOBNow := true
                    else
                        inBearOBNow := true

                // Evaluar invalidación por cierre fuera del extremo distal
                bool distalInvalid = ob.isBull ? (close < ob.bottom) : (close > ob.top)

                if distalInvalid
                    if i_enableBreaker and not ob.isBreaker
                        // Convertir en Breaker Block (invierte polaridad)
                        ob.isBull    := not ob.isBull
                        ob.isBreaker := true
                        if not na(ob.boxId)
                            color bbBrd = ob.isBull ? colBbBullBrd : colBbBearBrd
                            box.set_border_color(ob.boxId, bbBrd)
                            box.set_border_style(ob.boxId, line.style_dotted)
                            box.set_bgcolor(ob.boxId, color.new(colSubtle, 95))
                            box.set_text(ob.boxId, i_showBoxText ? (ob.isBull ? "BB+" : "BB-") : "")
                            box.set_text_color(ob.boxId, colMuted)
                    else
                        ob.mitigated := true
                        if not na(ob.boxId)
                            box.delete(ob.boxId)
                        array.remove(obList, i)
                else if not ob.isBreaker
                    // Evaluar mitigación según modo elegido
                    bool isMitigated = false
                    if i_obMitMode == "Proximal"
                        isMitigated := ob.isBull ? (low <= ob.top) : (high >= ob.bottom)
                    else if i_obMitMode == "50% Mean Threshold"
                        isMitigated := ob.isBull ? (low <= ob.mid) : (high >= ob.mid)
                    // En "Distal Invalidation", solo se invalida en el bloque distalInvalid arriba
                    if isMitigated
                        ob.mitigated := true
                        if not na(ob.boxId)
                            box.delete(ob.boxId)
                        array.remove(obList, i)

    // -------------------------------------------------------------------------
    // MÓDULO 2C: FAIR VALUE GAPS (FVG) — CAJAS GRISES LIMPIAS + RECORTE DINÁMICO
    // -------------------------------------------------------------------------

    if bar_index >= 2 and not na(atr14) and atr14 > 0.0
        float minFvgSize = i_fvgAtrMult * atr14

        // FVG Alcista: low > high[2]
        if low > high[2] and (low - high[2]) > minFvgSize
            float fTop = low
            float fBot = high[2]
            float fMid = (fTop + fBot) * 0.5
            box bFvg = i_showFVG ? box.new(
                 left = bar_index - 1, top = fTop, right = bar_index + 2, bottom = fBot,
                 border_color = colFvgBorder, border_width = 1,
                 bgcolor = colFvgBg,
                 text = i_showBoxText ? "FVG+" : "", text_size = size.tiny, text_color = colFvgText,
                 text_halign = text.align_right, text_valign = text.align_center
             ) : box(na)
            f_pushFVG(fvgList, FVG.new(fTop, fBot, fMid, bar_index - 1, true, false, false, bFvg), i_maxFVG)

        // FVG Bajista: high < low[2]
        if high < low[2] and (low[2] - high) > minFvgSize
            float fTop = low[2]
            float fBot = high
            float fMid = (fTop + fBot) * 0.5
            box bFvg = i_showFVG ? box.new(
                 left = bar_index - 1, top = fTop, right = bar_index + 2, bottom = fBot,
                 border_color = colFvgBorder, border_width = 1,
                 bgcolor = colFvgBg,
                 text = i_showBoxText ? "FVG-" : "", text_size = size.tiny, text_color = colFvgText,
                 text_halign = text.align_right, text_valign = text.align_center
             ) : box(na)
            f_pushFVG(fvgList, FVG.new(fTop, fBot, fMid, bar_index - 1, false, false, false, bFvg), i_maxFVG)

    // Actualizar, recortar o eliminar FVGs rellenados
    if array.size(fvgList) > 0
        for i = array.size(fvgList) - 1 to 0
            FVG f = array.get(fvgList, i)
            if bar_index > f.originBar + 1
                if not na(f.boxId)
                    box.set_right(f.boxId, bar_index + 2)

                if f.isBull
                    if low <= f.top and high >= f.bottom
                        inBullFVGNow := true
                    if i_fvgMitMode == "50% Fill"
                        if low <= f.mid
                            f.mitigated := true
                            if not na(f.boxId)
                                box.delete(f.boxId)
                            array.remove(fvgList, i)
                    else
                        if low <= f.bottom
                            f.mitigated := true
                            if not na(f.boxId)
                                box.delete(f.boxId)
                            array.remove(fvgList, i)
                        else if low < f.top
                            f.top := low
                            f.mid := (f.top + f.bottom) * 0.5
                            if not na(f.boxId)
                                box.set_top(f.boxId, f.top)
                else
                    if high >= f.bottom and low <= f.top
                        inBearFVGNow := true
                    if i_fvgMitMode == "50% Fill"
                        if high >= f.mid
                            f.mitigated := true
                            if not na(f.boxId)
                                box.delete(f.boxId)
                            array.remove(fvgList, i)
                    else
                        if high >= f.top
                            f.mitigated := true
                            if not na(f.boxId)
                                box.delete(f.boxId)
                            array.remove(fvgList, i)
                        else if high > f.bottom
                            f.bottom := high
                            f.mid := (f.top + f.bottom) * 0.5
                            if not na(f.boxId)
                                box.set_bottom(f.boxId, f.bottom)

    // -------------------------------------------------------------------------
    // MÓDULO 3: MOTOR WYCKOFF (MÁQUINA DE ESTADOS DE TRADING RANGE + EVENTOS)
    // -------------------------------------------------------------------------

    bool downTrendCtx = swingTrend == -1 or intTrend == -1 or (not na(ema50) and close < ema50)
    bool upTrendCtx   = swingTrend == 1 or intTrend == 1 or (not na(ema50) and close > ema50)
    bool climaxBar    = hasVolData and rvol > i_climaxRvol and relSpread > i_climaxSpread

    // Detección de SC (Selling Climax) y BC (Buying Climax) — inmediata o con rechazo en vela siguiente
    bool scImmediate = downTrendCtx and climaxBar and closePos >= 0.66
    bool scDelayed   = prevClimaxDn and close > open and closePos >= 0.55 and low >= (prevClimaxLow - 0.5 * atr14)
    bool scDetected  = scImmediate or scDelayed

    bool bcImmediate = upTrendCtx and climaxBar and closePos <= 0.34
    bool bcDelayed   = prevClimaxUp and close < open and closePos <= 0.45 and high <= (prevClimaxHi + 0.5 * atr14)
    bool bcDetected  = bcImmediate or bcDelayed

    // Estado 0: Buscando nuevo Clímax institucional para abrir Trading Range
    if not tr.active
        if scDetected
            float scLow = scImmediate ? low : prevClimaxLow
            int   scBar = scImmediate ? bar_index : prevClimaxBarDn
            tr.active          := true
            tr.bias            := 1
            tr.phase           := 1
            tr.lastPhaseMark   := 0
            tr.bottom          := scLow
            tr.top             := na
            tr.startBar        := scBar
            tr.climaxBar       := scBar
            tr.arBar           := na
            tr.lastSTBar       := na
            tr.hasST           := false
            tr.hasManip        := false
            tr.manipBar        := na
            tr.hasBreakout     := false
            tr.breakoutBar     := na
            tr.lpsBar          := na
            tr.pendingManip    := false
            tr.pendingManipBar := na
            tr.pendingExtreme  := na
            tr.trBox           := na
            tr.topLine         := na
            tr.botLine         := na
            if i_showWyckoff
                label lbSC = label.new(
                     x = scBar, y = scLow - (0.16 * nz(atr14)), text = "SC",
                     style = label.style_none, textcolor = colMuted, size = size.tiny,
                     tooltip = "Selling Climax (Wyckoff Acumulación) | RVOL: " + str.tostring(rvol, "#.##")
                 )
                f_pushLabel(wyckLabels, lbSC, i_maxWyckLabels)
        else if bcDetected
            float bcHigh = bcImmediate ? high : prevClimaxHi
            int   bcBar  = bcImmediate ? bar_index : prevClimaxBarUp
            tr.active          := true
            tr.bias            := -1
            tr.phase           := 1
            tr.lastPhaseMark   := 0
            tr.top             := bcHigh
            tr.bottom          := na
            tr.startBar        := bcBar
            tr.climaxBar       := bcBar
            tr.arBar           := na
            tr.lastSTBar       := na
            tr.hasST           := false
            tr.hasManip        := false
            tr.manipBar        := na
            tr.hasBreakout     := false
            tr.breakoutBar     := na
            tr.lpsBar          := na
            tr.pendingManip    := false
            tr.pendingManipBar := na
            tr.pendingExtreme  := na
            tr.trBox           := na
            tr.topLine         := na
            tr.botLine         := na
            if i_showWyckoff
                label lbBC = label.new(
                     x = bcBar, y = bcHigh + (0.16 * nz(atr14)), text = "BC",
                     style = label.style_none, textcolor = colMuted, size = size.tiny,
                     tooltip = "Buying Climax (Wyckoff Distribución) | RVOL: " + str.tostring(rvol, "#.##")
                 )
                f_pushLabel(wyckLabels, lbBC, i_maxWyckLabels)

    // Estado 1: Clímax detectado — esperando Automatic Rally / Automatic Reaction (AR)
    else if tr.phase == 1
        bool timedOut = (bar_index - tr.climaxBar) > 40
        if tr.bias == 1
            if close < tr.bottom - (1.5 * atr14) or timedOut
                tr.active := false
                tr.phase  := 0
                tr.bias   := 0
            else
                float arCandPrice = na
                int   arCandBar   = na
                if not na(swingPH) and (bar_index - i_swingLen) > tr.climaxBar and swingPH > tr.bottom + (0.5 * atr14)
                    arCandPrice := swingPH
                    arCandBar   := bar_index - i_swingLen
                else if not na(intPH) and (bar_index - i_intLen) > tr.climaxBar and intPH > tr.bottom + (0.5 * atr14)
                    arCandPrice := intPH
                    arCandBar   := bar_index - i_intLen

                if not na(arCandPrice)
                    tr.top   := arCandPrice
                    tr.arBar := arCandBar
                    tr.phase := 2
                    if i_showWyckoff
                        label lbAR = label.new(
                             x = arCandBar, y = arCandPrice + (0.16 * nz(atr14)), text = "AR",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Automatic Rally — Límite Superior del Trading Range"
                         )
                        f_pushLabel(wyckLabels, lbAR, i_maxWyckLabels)
                    if i_showTRBox
                        string trTitleA = (i_showWyckPhases or i_showBoxText) ? f_wyckoffBoxTitle(1, 2) : ""
                        tr.trBox := box.new(
                             left = tr.startBar, top = tr.top, right = bar_index + 2, bottom = tr.bottom,
                             border_color = colTrBrd, border_width = 1, border_style = line.style_dotted,
                             bgcolor = colTrBg,
                             text = trTitleA, text_size = size.tiny, text_color = colMuted,
                             text_halign = text.align_left, text_valign = text.align_top
                         )
                        f_pushBox(trHistBoxes, tr.trBox, i_maxTRHistory)
                        tr.topLine := line.new(tr.startBar, tr.top, bar_index + 2, tr.top, color = colTrLine, style = line.style_dashed)
                        tr.botLine := line.new(tr.startBar, tr.bottom, bar_index + 2, tr.bottom, color = colTrLine, style = line.style_dashed)
                        f_pushLine(trHistLines, tr.topLine, i_maxTRHistory * 6)
                        f_pushLine(trHistLines, tr.botLine, i_maxTRHistory * 6)
                    if i_showWyckPhases
                        tr.lastPhaseMark := 2
                        int fAX = int((tr.startBar + arCandBar) / 2)
                        label lbFA = label.new(
                             x = fAX, y = tr.top + (0.28 * nz(atr14)), text = "Fase A",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Acumulación · Fase A (Parada de tendencia bajista: SC + AR)"
                         )
                        f_pushLabel(wyckLabels, lbFA, i_maxWyckLabels)
        else if tr.bias == -1
            if close > tr.top + (1.5 * atr14) or timedOut
                tr.active := false
                tr.phase  := 0
                tr.bias   := 0
            else
                float arCandPrice = na
                int   arCandBar   = na
                if not na(swingPL) and (bar_index - i_swingLen) > tr.climaxBar and swingPL < tr.top - (0.5 * atr14)
                    arCandPrice := swingPL
                    arCandBar   := bar_index - i_swingLen
                else if not na(intPL) and (bar_index - i_intLen) > tr.climaxBar and intPL < tr.top - (0.5 * atr14)
                    arCandPrice := intPL
                    arCandBar   := bar_index - i_intLen

                if not na(arCandPrice)
                    tr.bottom := arCandPrice
                    tr.arBar  := arCandBar
                    tr.phase  := 2
                    if i_showWyckoff
                        label lbAR = label.new(
                             x = arCandBar, y = arCandPrice - (0.16 * nz(atr14)), text = "AR",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Automatic Reaction — Límite Inferior del Trading Range"
                         )
                        f_pushLabel(wyckLabels, lbAR, i_maxWyckLabels)
                    if i_showTRBox
                        string trTitleD = (i_showWyckPhases or i_showBoxText) ? f_wyckoffBoxTitle(-1, 2) : ""
                        tr.trBox := box.new(
                             left = tr.startBar, top = tr.top, right = bar_index + 2, bottom = tr.bottom,
                             border_color = colTrBrd, border_width = 1, border_style = line.style_dotted,
                             bgcolor = colTrBg,
                             text = trTitleD, text_size = size.tiny, text_color = colMuted,
                             text_halign = text.align_left, text_valign = text.align_bottom
                         )
                        f_pushBox(trHistBoxes, tr.trBox, i_maxTRHistory)
                        tr.topLine := line.new(tr.startBar, tr.top, bar_index + 2, tr.top, color = colTrLine, style = line.style_dashed)
                        tr.botLine := line.new(tr.startBar, tr.bottom, bar_index + 2, tr.bottom, color = colTrLine, style = line.style_dashed)
                        f_pushLine(trHistLines, tr.topLine, i_maxTRHistory * 6)
                        f_pushLine(trHistLines, tr.botLine, i_maxTRHistory * 6)
                    if i_showWyckPhases
                        tr.lastPhaseMark := 2
                        int fAX = int((tr.startBar + arCandBar) / 2)
                        label lbFA = label.new(
                             x = fAX, y = tr.bottom - (0.28 * nz(atr14)), text = "Fase A",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Distribución · Fase A (Parada de tendencia alcista: BC + AR)"
                         )
                        f_pushLabel(wyckLabels, lbFA, i_maxWyckLabels)

    // Estados 2, 3, 4: Trading Range Activo (ST, Spring/UTAD, SOS/SOW)
    else if tr.phase >= 2 and tr.phase <= 4
        if not na(tr.trBox)
            box.set_right(tr.trBox, bar_index + 2)
        if not na(tr.topLine)
            line.set_x2(tr.topLine, bar_index + 2)
        if not na(tr.botLine)
            line.set_x2(tr.botLine, bar_index + 2)

        float trHeight = math.max(tr.top - tr.bottom, not na(atr14) ? atr14 : 0.0001)

        if (bar_index - tr.startBar) > i_trMaxBars
            tr.active := false
            tr.phase  := 0
            tr.bias   := 0
        else if tr.bias == 1
            // 1) Recuperación pendiente de Spring (ventana 1-2 velas)
            if tr.pendingManip
                if (bar_index - tr.pendingManipBar) <= 2 and close > tr.bottom
                    wyckoffSpringNow  := true
                    tr.phase          := 4
                    tr.hasManip       := true
                    tr.manipBar       := bar_index
                    tr.pendingManip   := false
                    lastBullManipBar  := bar_index
                    if i_showWyckoff
                        label lbSp = label.new(
                             x = bar_index, y = math.min(low, tr.pendingExtreme) - (0.18 * nz(atr14)), text = "SPRING",
                             style = label.style_none, textcolor = i_colBull, size = size.tiny,
                             tooltip = "Wyckoff Spring (Recuperación en 1-2 velas dentro del TR)"
                         )
                        f_pushLabel(wyckLabels, lbSp, i_maxWyckLabels)
                else if (bar_index - tr.pendingManipBar) > 2
                    // Ruptura bajista confirmada sin recuperación -> invalida Acumulación
                    tr.active := false
                    tr.phase  := 0
                    tr.bias   := 0

            // 2) Spring en misma vela o inicio de recuperación pendiente
            if tr.active and not tr.pendingManip and low < tr.bottom
                if close > tr.bottom
                    wyckoffSpringNow := true
                    tr.phase         := 4
                    tr.hasManip      := true
                    tr.manipBar      := bar_index
                    lastBullManipBar := bar_index
                    if i_showWyckoff
                        label lbSp = label.new(
                             x = bar_index, y = low - (0.18 * nz(atr14)), text = "SPRING",
                             style = label.style_none, textcolor = i_colBull, size = size.tiny,
                             tooltip = "Wyckoff Spring (Barrido bajo TR y cierre dentro)"
                         )
                        f_pushLabel(wyckLabels, lbSp, i_maxWyckLabels)
                else
                    tr.pendingManip    := true
                    tr.pendingManipBar := bar_index
                    tr.pendingExtreme  := low

            // 3) Secondary Test (ST): testea zona SC con RVOL < 0.9 sin cerrar debajo
            if tr.active and not tr.pendingManip and tr.phase <= 3 and bar_index > tr.arBar + 2
                bool stCooldownOk = na(tr.lastSTBar) or (bar_index - tr.lastSTBar) > 5
                if stCooldownOk and low <= (tr.bottom + 0.25 * trHeight) and close >= tr.bottom and hasVolData and rvol < i_stMaxRvol
                    wyckoffBullSTNow   := true
                    tr.phase           := 3
                    tr.hasST           := true
                    tr.lastSTBar       := bar_index
                    lastBullVolConfBar := bar_index
                    if i_showWyckoff
                        label lbST = label.new(
                             x = bar_index, y = low - (0.16 * nz(atr14)), text = "ST",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Secondary Test (Bajo Volumen) | RVOL: " + str.tostring(rvol, "#.##")
                         )
                        f_pushLabel(wyckLabels, lbST, i_maxWyckLabels)

            // 4) Sign of Strength (SOS): ruptura alcista del TR con Spread > 1.3*ATR y RVOL > 1.5
            if tr.active and close > tr.top and relSpread > i_sosSpread and hasVolData and rvol > i_sosRvol
                wyckoffSosNow     := true
                tr.phase          := 5
                tr.hasBreakout    := true
                tr.breakoutBar    := bar_index
                tr.pendingManip   := false
                lastBullStructBar := bar_index
                if i_showWyckoff
                    label lbSOS = label.new(
                         x = bar_index, y = high + (0.18 * nz(atr14)), text = "SOS",
                         style = label.style_none, textcolor = i_colBull, size = size.tiny,
                         tooltip = "Sign of Strength | Spread: " + str.tostring(relSpread, "#.##") + "x ATR | RVOL: " + str.tostring(rvol, "#.##")
                     )
                    f_pushLabel(wyckLabels, lbSOS, i_maxWyckLabels)
                // Marcar OBs/FVGs creados durante el SOS
                if array.size(obList) > 0
                    OrderBlock lastOb = array.get(obList, array.size(obList) - 1)
                    if lastOb.isBull and (bar_index - lastOb.originBar) <= 5
                        lastOb.fromSOS := true
                if array.size(fvgList) > 0
                    FVG lastF = array.get(fvgList, array.size(fvgList) - 1)
                    if lastF.isBull and (bar_index - lastF.originBar) <= 3
                        lastF.fromSOS := true

        else if tr.bias == -1
            // 1) Recuperación pendiente de UTAD (ventana 1-2 velas)
            if tr.pendingManip
                if (bar_index - tr.pendingManipBar) <= 2 and close < tr.top
                    wyckoffUtadNow    := true
                    tr.phase          := 4
                    tr.hasManip       := true
                    tr.manipBar       := bar_index
                    tr.pendingManip   := false
                    lastBearManipBar  := bar_index
                    if i_showWyckoff
                        label lbUt = label.new(
                             x = bar_index, y = math.max(high, tr.pendingExtreme) + (0.18 * nz(atr14)), text = "UTAD",
                             style = label.style_none, textcolor = i_colBear, size = size.tiny,
                             tooltip = "Wyckoff UTAD (Recuperación en 1-2 velas dentro del TR)"
                         )
                        f_pushLabel(wyckLabels, lbUt, i_maxWyckLabels)
                else if (bar_index - tr.pendingManipBar) > 2
                    tr.active := false
                    tr.phase  := 0
                    tr.bias   := 0

            // 2) UTAD en misma vela o inicio de recuperación pendiente
            if tr.active and not tr.pendingManip and high > tr.top
                if close < tr.top
                    wyckoffUtadNow   := true
                    tr.phase         := 4
                    tr.hasManip      := true
                    tr.manipBar      := bar_index
                    lastBearManipBar := bar_index
                    if i_showWyckoff
                        label lbUt = label.new(
                             x = bar_index, y = high + (0.18 * nz(atr14)), text = "UTAD",
                             style = label.style_none, textcolor = i_colBear, size = size.tiny,
                             tooltip = "Wyckoff UTAD (Barrido sobre TR y cierre dentro)"
                         )
                        f_pushLabel(wyckLabels, lbUt, i_maxWyckLabels)
                else
                    tr.pendingManip    := true
                    tr.pendingManipBar := bar_index
                    tr.pendingExtreme  := high

            // 3) Secondary Test (ST) en Distribución
            if tr.active and not tr.pendingManip and tr.phase <= 3 and bar_index > tr.arBar + 2
                bool stCooldownOk = na(tr.lastSTBar) or (bar_index - tr.lastSTBar) > 5
                if stCooldownOk and high >= (tr.top - 0.25 * trHeight) and close <= tr.top and hasVolData and rvol < i_stMaxRvol
                    wyckoffBearSTNow   := true
                    tr.phase           := 3
                    tr.hasST           := true
                    tr.lastSTBar       := bar_index
                    lastBearVolConfBar := bar_index
                    if i_showWyckoff
                        label lbST = label.new(
                             x = bar_index, y = high + (0.16 * nz(atr14)), text = "ST",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Secondary Test (Bajo Volumen) | RVOL: " + str.tostring(rvol, "#.##")
                         )
                        f_pushLabel(wyckLabels, lbST, i_maxWyckLabels)

            // 4) Sign of Weakness (SOW): ruptura bajista del TR con Spread > 1.3*ATR y RVOL > 1.5
            if tr.active and close < tr.bottom and relSpread > i_sosSpread and hasVolData and rvol > i_sosRvol
                wyckoffSowNow     := true
                tr.phase          := 5
                tr.hasBreakout    := true
                tr.breakoutBar    := bar_index
                tr.pendingManip   := false
                lastBearStructBar := bar_index
                if i_showWyckoff
                    label lbSOW = label.new(
                         x = bar_index, y = low - (0.18 * nz(atr14)), text = "SOW",
                         style = label.style_none, textcolor = i_colBear, size = size.tiny,
                         tooltip = "Sign of Weakness | Spread: " + str.tostring(relSpread, "#.##") + "x ATR | RVOL: " + str.tostring(rvol, "#.##")
                     )
                    f_pushLabel(wyckLabels, lbSOW, i_maxWyckLabels)
                if array.size(obList) > 0
                    OrderBlock lastOb = array.get(obList, array.size(obList) - 1)
                    if not lastOb.isBull and (bar_index - lastOb.originBar) <= 5
                        lastOb.fromSOS := true
                if array.size(fvgList) > 0
                    FVG lastF = array.get(fvgList, array.size(fvgList) - 1)
                    if not lastF.isBull and (bar_index - lastF.originBar) <= 3
                        lastF.fromSOS := true

    // Estado 5: Post-SOS/SOW — esperando retroceso de bajo volumen (LPS / LPSY)
    else if tr.phase == 5
        float trMid = (tr.top + tr.bottom) * 0.5
        if (bar_index - tr.breakoutBar) > 40
            tr.active := false
            tr.phase  := 0
            tr.bias   := 0
        else if tr.bias == 1
            if close < trMid
                tr.active := false
                tr.phase  := 0
                tr.bias   := 0
            else if bar_index > tr.breakoutBar
                bool nearTRTop = low <= (tr.top + 0.4 * atr14) and close >= (tr.top - 0.5 * atr14)
                bool nearPOI   = inBullOBNow or inBullFVGNow
                if (nearTRTop or nearPOI) and hasVolData and rvol < i_lpsMaxRvol
                    wyckoffLpsNow      := true
                    tr.phase           := 6
                    tr.lpsBar          := bar_index
                    lastBullVolConfBar := bar_index
                    if i_showWyckoff
                        label lbLPS = label.new(
                             x = bar_index, y = low - (0.16 * nz(atr14)), text = "LPS",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Last Point of Support | RVOL: " + str.tostring(rvol, "#.##")
                         )
                        f_pushLabel(wyckLabels, lbLPS, i_maxWyckLabels)
        else if tr.bias == -1
            if close > trMid
                tr.active := false
                tr.phase  := 0
                tr.bias   := 0
            else if bar_index > tr.breakoutBar
                bool nearTRBot = high >= (tr.bottom - 0.4 * atr14) and close <= (tr.bottom + 0.5 * atr14)
                bool nearPOI   = inBearOBNow or inBearFVGNow
                if (nearTRBot or nearPOI) and hasVolData and rvol < i_lpsMaxRvol
                    wyckoffLpsyNow     := true
                    tr.phase           := 6
                    tr.lpsBar          := bar_index
                    lastBearVolConfBar := bar_index
                    if i_showWyckoff
                        label lbLPSY = label.new(
                             x = bar_index, y = high + (0.16 * nz(atr14)), text = "LPSY",
                             style = label.style_none, textcolor = colMuted, size = size.tiny,
                             tooltip = "Last Point of Supply | RVOL: " + str.tostring(rvol, "#.##")
                         )
                        f_pushLabel(wyckLabels, lbLPSY, i_maxWyckLabels)

    // Estado 6: Ciclo Wyckoff completado (LPS/LPSY) — liberar estado tras continuar tendencia
    else if tr.phase == 6
        if not na(tr.lpsBar) and (bar_index - tr.lpsBar) > 15
            tr.active := false
            tr.phase  := 0
            tr.bias   := 0

    // Actualizar título del Trading Range y dibujar separador de Fase (B, C, D, E) al avanzar fase
    if tr.active and tr.phase >= 3 and tr.phase > tr.lastPhaseMark and not na(tr.top) and not na(tr.bottom)
        tr.lastPhaseMark := tr.phase
        if not na(tr.trBox) and (i_showWyckPhases or i_showBoxText)
            box.set_text(tr.trBox, f_wyckoffBoxTitle(tr.bias, tr.phase))
        if i_showWyckPhases
            line phDiv = line.new(
                 x1 = bar_index, y1 = tr.top, x2 = bar_index, y2 = tr.bottom,
                 color = color.new(colSubtle, 65), style = line.style_dotted, width = 1
             )
            f_pushLine(trHistLines, phDiv, i_maxTRHistory * 6)
            string phLblTxt = f_wyckoffPhaseLetter(tr.phase)
            string phTip = (tr.bias == 1 ? "Acumulación · " : "Distribución · ") + f_wyckoffStateLabel(tr.phase, tr.bias)
            float phY = tr.bias == 1 ? (tr.top + 0.28 * nz(atr14)) : (tr.bottom - 0.28 * nz(atr14))
            color phCol = tr.phase >= 4 ? (tr.bias == 1 ? i_colBull : i_colBear) : colMuted
            label lbPh = label.new(
                 x = bar_index, y = phY, text = phLblTxt,
                 style = label.style_none, textcolor = phCol, size = size.tiny, tooltip = phTip
             )
            f_pushLabel(wyckLabels, lbPh, i_maxWyckLabels)

    // Actualizar memoria de velas climáticas para detección SC/BC en vela siguiente
    prevClimaxDn    := downTrendCtx and climaxBar and close < open and not scImmediate
    prevClimaxLow   := prevClimaxDn ? low : na
    prevClimaxBarDn := prevClimaxDn ? bar_index : na

    prevClimaxUp    := upTrendCtx and climaxBar and close > open and not bcImmediate
    prevClimaxHi    := prevClimaxUp ? high : na
    prevClimaxBarUp := prevClimaxUp ? bar_index : na

    // -------------------------------------------------------------------------
    // MÓDULO 4: MOTOR DE CONFLUENCIA (SCORING 0 A 100 PTS + SEÑALES A+)
    // -------------------------------------------------------------------------

    bool hasBullPOI = f_hasActivePOI(obList, fvgList, true, low, high, atr14, bar_index, i_confWindow)
    bool hasBearPOI = f_hasActivePOI(obList, fvgList, false, low, high, atr14, bar_index, i_confWindow)

    // --- Scoring LONG (0-100) ---
    int ptsManipL  = (not na(lastBullManipBar) and (bar_index - lastBullManipBar) <= i_confWindow) ? 25 : 0
    int ptsStructL = (not na(lastBullStructBar) and (bar_index - lastBullStructBar) <= i_confWindow) ? 25 : 0
    int ptsZoneL   = (not na(pdEq) and low <= pdEq) ? 20 : 0
    int ptsPoiL    = hasBullPOI ? 15 : 0
    int ptsVolL    = (not na(lastBullVolConfBar) and (bar_index - lastBullVolConfBar) <= i_confWindow) ? 15 : 0
    liveScoreLong := ptsManipL + ptsStructL + ptsZoneL + ptsPoiL + ptsVolL

    // --- Scoring SHORT (0-100) ---
    int ptsManipS  = (not na(lastBearManipBar) and (bar_index - lastBearManipBar) <= i_confWindow) ? 25 : 0
    int ptsStructS = (not na(lastBearStructBar) and (bar_index - lastBearStructBar) <= i_confWindow) ? 25 : 0
    int ptsZoneS   = (not na(pdEq) and high >= pdEq) ? 20 : 0
    int ptsPoiS    = hasBearPOI ? 15 : 0
    int ptsVolS    = (not na(lastBearVolConfBar) and (bar_index - lastBearVolConfBar) <= i_confWindow) ? 15 : 0
    liveScoreShort := ptsManipS + ptsStructS + ptsZoneS + ptsPoiS + ptsVolS

    bool bullTrigger  = wyckoffSpringNow or bullSweepNow or bullMSSNow or wyckoffSosNow or wyckoffLpsNow or (inBullOBNow and (vsaBullAbs or close > open))
    bool bearTrigger  = wyckoffUtadNow or bearSweepNow or bearMSSNow or wyckoffSowNow or wyckoffLpsyNow or (inBearOBNow and (vsaBearAbs or close < open))

    bool longCoolOk   = na(lastLongSigBar) or (bar_index - lastLongSigBar) >= i_signalCooldown
    bool shortCoolOk  = na(lastShortSigBar) or (bar_index - lastShortSigBar) >= i_signalCooldown

    if liveScoreLong >= i_minScore and bullTrigger and longCoolOk and liveScoreLong >= liveScoreShort
        sigAPlusLong        := true
        lastLongSigBar      := bar_index
        lastConfluenceScore := liveScoreLong
        lastConfluenceDir   := "LONG"
        if i_showSignals
            string tipL = (
                 "A+ LONG — Score: " + str.tostring(liveScoreLong) + "/100" +
                 "\n• Manipulación (Spring/Sweep): +" + str.tostring(ptsManipL) +
                 "\n• Estructura (MSS/SOS): +" + str.tostring(ptsStructL) +
                 "\n• Zona Discount: +" + str.tostring(ptsZoneL) +
                 "\n• POI (OB/FVG): +" + str.tostring(ptsPoiL) +
                 "\n• Volumen (VSA/ST/LPS): +" + str.tostring(ptsVolL)
             )
            label lbSigL = label.new(
                 x = bar_index, y = low - (0.30 * nz(atr14)),
                 text = "A+ LONG · " + str.tostring(liveScoreLong),
                 style = label.style_label_up, color = colSigLongBg,
                 textcolor = color.white, size = size.small, tooltip = tipL
             )
            f_pushLabel(sigLabels, lbSigL, i_maxSigLabels)
        if i_enableDynAlerts
            alert("A+ LONG | " + syminfo.ticker + " (" + timeframe.period + ") | Score: " + str.tostring(liveScoreLong) + "/100 @ " + str.tostring(close), alert.freq_once_per_bar_close)

    if liveScoreShort >= i_minScore and bearTrigger and shortCoolOk and liveScoreShort > liveScoreLong
        sigAPlusShort       := true
        lastShortSigBar     := bar_index
        lastConfluenceScore := liveScoreShort
        lastConfluenceDir   := "SHORT"
        if i_showSignals
            string tipS = (
                 "A+ SHORT — Score: " + str.tostring(liveScoreShort) + "/100" +
                 "\n• Manipulación (UTAD/Sweep): +" + str.tostring(ptsManipS) +
                 "\n• Estructura (MSS/SOW): +" + str.tostring(ptsStructS) +
                 "\n• Zona Premium: +" + str.tostring(ptsZoneS) +
                 "\n• POI (OB/FVG): +" + str.tostring(ptsPoiS) +
                 "\n• Volumen (VSA/ST/LPSY): +" + str.tostring(ptsVolS)
             )
            label lbSigS = label.new(
                 x = bar_index, y = high + (0.30 * nz(atr14)),
                 text = "A+ SHORT · " + str.tostring(liveScoreShort),
                 style = label.style_label_down, color = colSigShortBg,
                 textcolor = color.white, size = size.small, tooltip = tipS
             )
            f_pushLabel(sigLabels, lbSigS, i_maxSigLabels)
        if i_enableDynAlerts
            alert("A+ SHORT | " + syminfo.ticker + " (" + timeframe.period + ") | Score: " + str.tostring(liveScoreShort) + "/100 @ " + str.tostring(close), alert.freq_once_per_bar_close)

    // --- Marcas direccionales minimalistas ▲ LONG / ▼ SHORT (cuando no ya se marcó A+) ---
    bool stdBullEvent = bullMSSNow or wyckoffSpringNow or wyckoffSosNow or wyckoffLpsNow
    bool stdBearEvent = bearMSSNow or wyckoffUtadNow or wyckoffSowNow or wyckoffLpsyNow

    if i_showStdSignals and not sigAPlusLong and stdBullEvent and liveScoreLong >= i_stdMinScore and longCoolOk and liveScoreLong >= liveScoreShort
        lastLongSigBar := bar_index
        string tipStdL = (
             "LONG — Score: " + str.tostring(liveScoreLong) + "/100" +
             "\n• Manipulación: +" + str.tostring(ptsManipL) +
             " | Estructura: +" + str.tostring(ptsStructL) +
             "\n• Discount: +" + str.tostring(ptsZoneL) +
             " | POI: +" + str.tostring(ptsPoiL) +
             " | Vol: +" + str.tostring(ptsVolL)
         )
        label lbStdL = label.new(
             x = bar_index, y = low - (0.34 * nz(atr14)), text = "▲ LONG",
             style = label.style_none, textcolor = i_colBull, size = size.tiny, tooltip = tipStdL
         )
        f_pushLabel(sigLabels, lbStdL, i_maxSigLabels)

    if i_showStdSignals and not sigAPlusShort and stdBearEvent and liveScoreShort >= i_stdMinScore and shortCoolOk and liveScoreShort > liveScoreLong
        lastShortSigBar := bar_index
        string tipStdS = (
             "SHORT — Score: " + str.tostring(liveScoreShort) + "/100" +
             "\n• Manipulación: +" + str.tostring(ptsManipS) +
             " | Estructura: +" + str.tostring(ptsStructS) +
             "\n• Premium: +" + str.tostring(ptsZoneS) +
             " | POI: +" + str.tostring(ptsPoiS) +
             " | Vol: +" + str.tostring(ptsVolS)
         )
        label lbStdS = label.new(
             x = bar_index, y = high + (0.34 * nz(atr14)), text = "▼ SHORT",
             style = label.style_none, textcolor = i_colBear, size = size.tiny, tooltip = tipStdS
         )
        f_pushLabel(sigLabels, lbStdS, i_maxSigLabels)

// =============================================================================
// 7. VISUALIZACIÓN VSA (PLOTSHAPE GLOBAL — PUNTOS MINIMALISTAS)
// =============================================================================

plotshape(
     i_showVSA and vsaBullAbs,
     title     = "VSA Absorción Alcista",
     style     = shape.circle,
     location  = location.belowbar,
     color     = colVsaDot,
     size      = size.tiny
 )

plotshape(
     i_showVSA and vsaBearAbs,
     title     = "VSA Absorción Bajista",
     style     = shape.circle,
     location  = location.abovebar,
     color     = colVsaDot,
     size      = size.tiny
 )

// =============================================================================
// 7B. MODO SOMBRA — PROYECCIÓN FUTURA ESTIMADA (ÚLTIMAS VELAS + SMC + WYCKOFF)
// =============================================================================
// Solo proyecta hacia el futuro en barstate.islast (0 repintado histórico).

var line     gMid1 = na
var line     gMid2 = na
var line     gMid3 = na
var line     gUp1  = na
var line     gUp2  = na
var line     gUp3  = na
var line     gLo1  = na
var line     gLo2  = na
var line     gLo3  = na
var linefill gFl1  = na
var linefill gFl2  = na
var linefill gFl3  = na
var label    gLbl  = na
var string   ghostBiasTxt = "—"
var int      ghostBiasDir = 0

if i_showGhost and barstate.islast
    float gAtr = math.max(nz(atr14, barRange), syminfo.mintick * 10.0)
    int h1 = math.max(2, int(math.round(i_ghostHorizon * 0.30)))
    int h2 = math.max(h1 + 2, int(math.round(i_ghostHorizon * 0.65)))
    int h3 = math.max(h2 + 2, i_ghostHorizon)

    int x0 = bar_index
    int x1 = bar_index + h1
    int x2 = bar_index + h2
    int x3 = bar_index + h3

    float y0 = close
    float y1 = close
    float y2 = close
    float y3 = close
    string scenarioTxt = "Rango Neutral"
    string scenarioTip = ""

    // 1) Si hay un Trading Range Wyckoff activo, seguir la hoja de ruta de la Fase actual
    if tr.active and tr.phase >= 2 and not na(tr.top) and not na(tr.bottom)
        float trH = math.max(tr.top - tr.bottom, gAtr)
        float trM = (tr.top + tr.bottom) * 0.5
        if tr.bias == 1
            ghostBiasDir := 1
            if tr.phase <= 3
                y1 := tr.bottom - (0.12 * trH)
                y2 := tr.top - (0.08 * trH)
                y3 := tr.top + (0.45 * trH)
                scenarioTxt := "Acum. " + f_wyckoffPhaseLetter(tr.phase) + " → Spring/SOS"
                ghostBiasTxt := "Alcista (TR)"
            else if tr.phase == 4
                y1 := math.max(close + 0.3 * gAtr, trM)
                y2 := tr.top + (0.20 * trH)
                y3 := tr.top + (0.75 * trH)
                scenarioTxt := "Fase C (Spring) → SOS"
                ghostBiasTxt := "Alcista (Spring)"
            else if tr.phase == 5
                y1 := tr.top + (0.05 * trH)
                y2 := math.max(close + 0.5 * gAtr, tr.top + 0.55 * trH)
                y3 := tr.top + (1.00 * trH)
                scenarioTxt := "Fase D (SOS) → LPS → Markup"
                ghostBiasTxt := "Alcista (SOS)"
            else
                y1 := close + (0.45 * gAtr)
                y2 := math.max(close + 1.1 * gAtr, tr.top + 0.70 * trH)
                y3 := math.max(close + 1.8 * gAtr, tr.top + 1.15 * trH)
                scenarioTxt := "Fase E (LPS) → Markup"
                ghostBiasTxt := "Alcista (Fase E)"
        else if tr.bias == -1
            ghostBiasDir := -1
            if tr.phase <= 3
                y1 := tr.top + (0.12 * trH)
                y2 := tr.bottom + (0.08 * trH)
                y3 := tr.bottom - (0.45 * trH)
                scenarioTxt := "Dist. " + f_wyckoffPhaseLetter(tr.phase) + " → UTAD/SOW"
                ghostBiasTxt := "Bajista (TR)"
            else if tr.phase == 4
                y1 := math.min(close - 0.3 * gAtr, trM)
                y2 := tr.bottom - (0.20 * trH)
                y3 := tr.bottom - (0.75 * trH)
                scenarioTxt := "Fase C (UTAD) → SOW"
                ghostBiasTxt := "Bajista (UTAD)"
            else if tr.phase == 5
                y1 := tr.bottom - (0.05 * trH)
                y2 := math.min(close - 0.5 * gAtr, tr.bottom - 0.55 * trH)
                y3 := tr.bottom - (1.00 * trH)
                scenarioTxt := "Fase D (SOW) → LPSY → Markdown"
                ghostBiasTxt := "Bajista (SOW)"
            else
                y1 := close - (0.45 * gAtr)
                y2 := math.min(close - 1.1 * gAtr, tr.bottom - 0.70 * trH)
                y3 := math.min(close - 1.8 * gAtr, tr.bottom - 1.15 * trH)
                scenarioTxt := "Fase E (LPSY) → Markdown"
                ghostBiasTxt := "Bajista (Fase E)"
        scenarioTip := "Modo Sombra (Wyckoff)\n• Escenario: " + scenarioTxt + "\n• Presión últimas " + str.tostring(i_ghostLookback) + " velas: " + str.tostring(nz(avgCandleBias), "#.##") + "\n• Objetivo estimado: " + str.tostring(y3, format.mintick)
    else
        // 2) Sin TR activo: combinar Tendencia Swing/Interna + Score Vivo + Presión VSA de últimas N velas + POIs
        float clampedPress = math.max(-1.5, math.min(1.5, nz(avgCandleBias) * 1.5))
        float scoreBias    = (liveScoreLong - liveScoreShort) / 50.0
        float totalBias    = (swingTrend * 1.2) + (intTrend * 0.8) + scoreBias + clampedPress

        if totalBias >= 0.35
            ghostBiasDir := 1
            ghostBiasTxt := "Est. Alcista"
            float nearBullPOI = f_findNearestPOI(obList, fvgList, true, close, gAtr * 3.0)
            float bullTarget  = not na(pdHigh) and pdHigh > close + (0.8 * gAtr) ? pdHigh : (close + 2.1 * gAtr)
            if not na(nearBullPOI)
                y1 := nearBullPOI
                y2 := close + (0.85 * gAtr)
                y3 := bullTarget
                scenarioTxt := "Sombra · Pullback POI → Alcista"
            else
                float momStep = math.max(0.35 * gAtr, math.min(1.2 * gAtr, avgPriceSlope * h1))
                y1 := close + momStep
                y2 := y1 - (0.35 * gAtr)
                y3 := math.max(bullTarget, y1 + 1.15 * gAtr)
                scenarioTxt := "Sombra · Est. Alcista"
        else if totalBias <= -0.35
            ghostBiasDir := -1
            ghostBiasTxt := "Est. Bajista"
            float nearBearPOI = f_findNearestPOI(obList, fvgList, false, close, gAtr * 3.0)
            float bearTarget  = not na(pdLow) and pdLow < close - (0.8 * gAtr) ? pdLow : (close - 2.1 * gAtr)
            if not na(nearBearPOI)
                y1 := nearBearPOI
                y2 := close - (0.85 * gAtr)
                y3 := bearTarget
                scenarioTxt := "Sombra · Pullback POI → Bajista"
            else
                float momStep = math.max(0.35 * gAtr, math.min(1.2 * gAtr, -avgPriceSlope * h1))
                y1 := close - momStep
                y2 := y1 + (0.35 * gAtr)
                y3 := math.min(bearTarget, y1 - 1.15 * gAtr)
                scenarioTxt := "Sombra · Est. Bajista"
        else
            ghostBiasDir := 0
            ghostBiasTxt := "Rango Neutral"
            float dirSign = nz(avgCandleBias) >= 0.0 ? 1.0 : -1.0
            y1 := close + (0.45 * gAtr * dirSign)
            y2 := close - (0.45 * gAtr * dirSign)
            y3 := close + (0.15 * gAtr * dirSign)
            scenarioTxt := "Sombra · Rango Neutral"

        scenarioTip := "Modo Sombra (Velas + SMC)\n• Sesgo compuesto: " + str.tostring(totalBias, "#.##") + "\n• Presión últimas " + str.tostring(i_ghostLookback) + " velas: " + str.tostring(nz(avgCandleBias), "#.##") + "\n• Objetivo estimado: " + str.tostring(y3, format.mintick) + "\n• Nota: Proyección estadística, no certeza."

    // Amplitud del cono de sombra proporcional al ATR
    float s1 = 0.45 * gAtr
    float s2 = 0.78 * gAtr
    float s3 = 1.10 * gAtr

    // Actualizar o crear las 3 líneas centrales punteadas
    if na(gMid1)
        gMid1 := line.new(x0, y0, x1, y1, color = colGhostLine, style = line.style_dotted, width = 1)
        gMid2 := line.new(x1, y1, x2, y2, color = colGhostLine, style = line.style_dotted, width = 1)
        gMid3 := line.new(x2, y2, x3, y3, color = colGhostLine, style = line.style_arrow_right, width = 1)
    else
        line.set_xy1(gMid1, x0, y0)
        line.set_xy2(gMid1, x1, y1)
        line.set_xy1(gMid2, x1, y1)
        line.set_xy2(gMid2, x2, y2)
        line.set_xy1(gMid3, x2, y2)
        line.set_xy2(gMid3, x3, y3)

    // Actualizar o crear el cono translúcido (sombra)
    if i_showGhostCone
        if na(gUp1)
            gUp1 := line.new(x0, y0, x1, y1 + s1, color = colGhostEdge, style = line.style_dotted, width = 1)
            gLo1 := line.new(x0, y0, x1, y1 - s1, color = colGhostEdge, style = line.style_dotted, width = 1)
            gUp2 := line.new(x1, y1 + s1, x2, y2 + s2, color = colGhostEdge, style = line.style_dotted, width = 1)
            gLo2 := line.new(x1, y1 - s1, x2, y2 - s2, color = colGhostEdge, style = line.style_dotted, width = 1)
            gUp3 := line.new(x2, y2 + s2, x3, y3 + s3, color = colGhostEdge, style = line.style_dotted, width = 1)
            gLo3 := line.new(x2, y2 - s2, x3, y3 - s3, color = colGhostEdge, style = line.style_dotted, width = 1)
            gFl1 := linefill.new(gUp1, gLo1, colGhostCone)
            gFl2 := linefill.new(gUp2, gLo2, colGhostCone)
            gFl3 := linefill.new(gUp3, gLo3, colGhostCone)
        else
            line.set_xy1(gUp1, x0, y0)
            line.set_xy2(gUp1, x1, y1 + s1)
            line.set_xy1(gLo1, x0, y0)
            line.set_xy2(gLo1, x1, y1 - s1)
            line.set_xy1(gUp2, x1, y1 + s1)
            line.set_xy2(gUp2, x2, y2 + s2)
            line.set_xy1(gLo2, x1, y1 - s1)
            line.set_xy2(gLo2, x2, y2 - s2)
            line.set_xy1(gUp3, x2, y2 + s2)
            line.set_xy2(gUp3, x3, y3 + s3)
            line.set_xy1(gLo3, x2, y2 - s2)
            line.set_xy2(gLo3, x3, y3 - s3)

    // Etiqueta minimalista al final de la sombra
    if na(gLbl)
        gLbl := label.new(
             x = x3, y = y3, text = scenarioTxt,
             style = label.style_none, textcolor = colMuted, size = size.tiny, tooltip = scenarioTip
         )
    else
        label.set_xy(gLbl, x3, y3)
        label.set_text(gLbl, scenarioTxt)
        label.set_tooltip(gLbl, scenarioTip)

// =============================================================================
// 8. DASHBOARD INSTITUCIONAL (MINIMALISTA LIGHT / ADAPTATIVO)
// =============================================================================

var table dash = table.new(
     position     = position.top_right,
     columns      = 2,
     rows         = 9,
     bgcolor      = colDashBg,
     border_width = 1,
     border_color = colDashBrd,
     frame_width  = 1,
     frame_color  = colDashBrd
 )

if barstate.isfirst
    table.merge_cells(dash, 0, 0, 1, 0)

if i_showDash and barstate.islast
    // Zona actual Premium / Discount / Equilibrium
    string zoneTxt = "N/A"
    color  zoneCol = colDashMuted
    if not na(pdHigh) and not na(pdLow) and not na(pdEq) and pdHigh > pdLow
        float eqBand = (pdHigh - pdLow) * 0.025
        if math.abs(close - pdEq) <= eqBand
            zoneTxt := "Equilibrium"
            zoneCol := colDashMuted
        else if close > pdEq
            zoneTxt := "Premium"
            zoneCol := i_colBear
        else
            zoneTxt := "Discount"
            zoneCol := i_colBull

    string wyckTxt = tr.active ? f_wyckoffStateLabel(tr.phase, tr.bias) : "Tendencia"
    color  wyckCol = tr.active ? (tr.bias == 1 ? i_colBull : i_colBear) : colDashMuted

    color swingCol = swingTrend == 1 ? i_colBull : swingTrend == -1 ? i_colBear : colDashMuted
    color intCol   = intTrend == 1 ? i_colBull : intTrend == -1 ? i_colBear : colDashMuted
    color scoreCol = lastConfluenceScore >= i_minScore ? (lastConfluenceDir == "LONG" ? i_colBull : i_colBear) : colDashMuted
    color ghostCol = ghostBiasDir == 1 ? i_colBull : ghostBiasDir == -1 ? i_colBear : colDashMuted

    string lastScoreStr = lastConfluenceScore > 0 ? (str.tostring(lastConfluenceScore) + " / 100 · " + lastConfluenceDir) : "—"
    string liveScoreStr = "L " + str.tostring(liveScoreLong) + " · S " + str.tostring(liveScoreShort)
    string poiStr       = "OB " + str.tostring(array.size(obList)) + " · FVG " + str.tostring(array.size(fvgList)) + " · " + str.tostring(rvol, "#.#") + "x"

    table.cell(dash, 0, 0, "SMC · WYCKOFF", text_color = colDashTitle, bgcolor = colDashHead, text_halign = text.align_center, text_size = dashSz)

    table.cell(dash, 0, 1, "Swing", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 1, f_trendLabel(swingTrend), text_color = swingCol, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 2, "Interna", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 2, f_trendLabel(intTrend), text_color = intCol, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 3, "Zona", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 3, zoneTxt, text_color = zoneCol, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 4, "Wyckoff", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 4, wyckTxt, text_color = wyckCol, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 5, "Último A+", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 5, lastScoreStr, text_color = scoreCol, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 6, "Score Vivo", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 6, liveScoreStr, text_color = colDashVal, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 7, "Modo Sombra", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 7, i_showGhost ? ghostBiasTxt : "Off", text_color = ghostCol, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

    table.cell(dash, 0, 8, "POIs · RVOL", text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_left, text_size = dashSz)
    table.cell(dash, 1, 8, poiStr, text_color = colDashMuted, bgcolor = colDashBg, text_halign = text.align_right, text_size = dashSz)

// =============================================================================
// 9. ALERTAS (ÁMBITO GLOBAL — ANTI-REPINTADO GARANTIZADO)
// =============================================================================

alertcondition(sigAPlusLong, title = "Nueva Señal A+ LONG", message = "SMC + Wyckoff: Nueva señal A+ LONG confirmada en {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(sigAPlusShort, title = "Nueva Señal A+ SHORT", message = "SMC + Wyckoff: Nueva señal A+ SHORT confirmada en {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(sigAPlusLong or sigAPlusShort, title = "Nueva Señal A+ (LONG o SHORT)", message = "SMC + Wyckoff: Nueva señal A+ confirmada en {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(wyckoffSpringNow or wyckoffUtadNow, title = "Detección de Spring / UTAD", message = "SMC + Wyckoff: Evento Wyckoff Spring / UTAD confirmado en {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(bullMSSNow or bearMSSNow, title = "Detección de MSS", message = "SMC + Wyckoff: Cambio de Estructura con Desplazamiento (MSS) en {{ticker}} ({{interval}}) @ {{close}}")
alertcondition(enteredActiveOB, title = "Precio Entrando en Order Block Activo", message = "SMC + Wyckoff: Precio entrando en Order Block activo en {{ticker}} ({{interval}}) @ {{close}}")
